# Default values (overridden by env vars if set)
myhostname = HOSTNAME
mydomain = DOMAIN

# OCI Email Delivery - Port 465 SMTPS
# https://docs.oracle.com/en-us/iaas/Content/Email/Reference/postfix.htm 
relayhost = [RELAY_HOST]:RELAY_PORT

## TLS Configuration (required by Oracle)
smtp_tls_mandatory_protocols = TLSv1.2
smtp_use_tls = yes
# smtp_tls_wrappermode = yes
smtp_tls_security_level = encrypt
smtp_tls_mandatory_ciphers = high

smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
smtp_sasl_mechanism_filter = plain, login

mynetworks = 0.0.0.0/0

inet_interfaces = all
# Force IPv4 only to avoid AAAA lookup issues
inet_protocols = ipv4
smtp_address_preference = ipv4

maillog_file = /dev/stdout
debug_peer_level = 10

# local_transport = error:local delivery is disabled
# mydestination =
# local_recipient_maps =

# smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
# smtpd_recipient_restrictions = permit_mynetworks permit_sasl_authenticated reject_unauth_destination

#TODO: Relay restrictions
# smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination

# Docker default bridge network + your container's subnet
# mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128 172.16.0.0/12 10.0.0.0/8

# DANGEROUS:  Disable all restrictions creates an open relay if you're not careful.
# WARNING: This configuration creates an open relay.  Anyone on your network can send mail through your server.
# smtpd_recipient_restrictions = permit

# SAFER but STILL BAD: Allow all networks but prevent open relay (Safer)
mynetworks = 0.0.0.0/0
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination

message_size_limit = 52428800
