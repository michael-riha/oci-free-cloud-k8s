compartment_id   = "<found in ~.oci/config -> tenancy>"
region            = "<found in ~.oci/config -> region>"
# needs to be created from the private *.pem key
ssh_public_key_path   = "<found in credentials/.oci/oci_api_key_public.pub | e.g. ~/.oci/oci_api_key_public.pub>"

# for optional email delivery
enable_email_delivery = false

# if enable_email_delivery = true this is the setup
email_delivery_config = {
  domain           = "your.domain.com"
  approved_senders = ["noreply@your.domain.com"]
  smtp_user_email = "smtp_user@your.domain.com"
}
